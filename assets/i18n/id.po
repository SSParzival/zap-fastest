msgstr "Klien WhatsApp native."

#: src/ui/login.rs:98 src/ui/call.rs:23
msgid "Connecting to WhatsApp…"
msgstr "Menghubungkan ke WhatsApp…"

#: src/ui/login.rs:105
msgid "Linked. Waiting for your chats…"
msgstr "Tertaut. Menunggu chat Anda…"

#: src/ui/login.rs:114
msgid "This computer was unlinked from your phone. Requesting a new code."
msgstr "Tautan komputer ini diputus dari ponsel Anda. Meminta kode baru."

#: src/ui/login.rs:123
msgid "Requesting a new code…"
msgstr "Meminta kode baru…"

