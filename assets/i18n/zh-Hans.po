msgstr "加密账号备份"

#: src/ui/settings.rs:1020
msgid ""
"Save the account and downloaded files with a passphrase. Restore into a "
"separate account, initially offline."
msgstr "使用口令保存账号和已下载的文件。恢复到独立账号，初始状态为离线。"

#: src/ui/settings.rs:1023
msgid "Back up…"
msgstr "备份…"

#: src/ui/settings.rs:1027
msgid "Restore…"
msgstr "恢复…"

#: src/ui/settings.rs:1032
msgid "Review merge…"
msgstr "检查合并…"

#: src/ui/settings.rs:1039
