#: src/ui/login.rs:12
msgid "A native WhatsApp client."
msgstr "Un client WhatsApp natif."

#: src/ui/login.rs:98 src/ui/call.rs:23
msgid "Connecting to WhatsApp…"
msgstr "Connexion à WhatsApp…"

#: src/ui/login.rs:105
msgid "Linked. Waiting for your chats…"
msgstr "Associé. En attente de vos discussions…"

#: src/ui/login.rs:114
msgid "This computer was unlinked from your phone. Requesting a new code."
msgstr ""
"Cet ordinateur a été dissocié du téléphone. Demande d’un nouveau code."

#: src/ui/login.rs:123
msgid "Requesting a new code…"
msgstr "Demande d’un nouveau code…"

