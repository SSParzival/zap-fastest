msgstr[1] "{count} fichiers en attente"

#: src/ui/settings.rs:965
#, rust-format
msgid "{count} file cancelled"
msgid_plural "{count} files cancelled"
msgstr[0] "{count} fichier annulé"
msgstr[1] "{count} fichiers annulés"

#: src/ui/settings.rs:966
#, rust-format
msgid "{count} file unavailable"
msgid_plural "{count} files unavailable"
msgstr[0] "{count} fichier indisponible"
