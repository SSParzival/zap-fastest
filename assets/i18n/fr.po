msgid "Oldest saved message: unknown"
msgstr "Message enregistré le plus ancien : inconnu"

#: src/ui/settings.rs:972
#, rust-format
msgid "Oldest saved message: {date} (UTC)"
msgstr "Message enregistré le plus ancien : {date} (UTC)"

#: src/ui/settings.rs:973
msgid "WhatsApp connection: disconnected"
msgstr "Connexion WhatsApp : déconnectée"

#: src/ui/settings.rs:974
msgid "Phone history: no request observed this session"
msgstr "Historique du téléphone : aucune demande observée dans cette session"

#: src/ui/settings.rs:975
msgid "Phone history: waiting for a response"
msgstr "Historique du téléphone : en attente d’une réponse"

#: src/ui/settings.rs:976
msgid "Phone history: response received"
msgstr "Historique du téléphone : réponse reçue"

#: src/ui/settings.rs:977
msgid "Phone history: request failed or no response yet"
msgstr ""
"Historique du téléphone : échec de la demande ou pas encore de réponse"

#: src/ui/settings.rs:980
msgid "Background downloads paused at the storage limit."
msgstr "Téléchargements en arrière-plan suspendus à la limite de stockage."

#: src/ui/settings.rs:981
msgid "Background downloads paused: storage usage could not be measured."
msgstr ""
"Téléchargements en arrière-plan suspendus : impossible de mesurer l’espace "
"utilisé."

#: src/ui/settings.rs:986
msgid "Background media storage limit"
msgstr "Limite de stockage des médias en arrière-plan"

#: src/ui/settings.rs:987
msgid ""
"Pause new background downloads at this limit. Existing archived files are "
"kept. Increase it to continue, or use 0 for unlimited (MiB)."
msgstr ""
"Suspend les nouveaux téléchargements en arrière-plan à cette limite. Les "
"fichiers archivés sont conservés. Augmentez-la pour continuer ou utilisez 0 "
"pour ne pas limiter (Mio)."

#: src/ui/settings.rs:997
msgid "Unused cache cleanup"
msgstr "Nettoyage des fichiers du cache inutilisés"

#: src/ui/settings.rs:998
msgid ""
"Remove only old, unreferenced media-cache files. Archived attachments and "
"background recovery files stay saved. Removed files may not be recoverable."
msgstr ""
"Supprimer uniquement les anciens fichiers multimédias du cache qui ne sont "
"plus référencés. Les pièces jointes archivées et les fichiers de "
"récupération en arrière-plan restent enregistrés. Les fichiers supprimés "
"pourraient ne pas être récupérables."

#: src/ui/settings.rs:1003
msgid "Remove unused files automatically"
msgstr "Supprimer automatiquement les fichiers inutilisés"

#: src/ui/settings.rs:1006
msgid "Keep unused files for this many days"
msgstr "Conserver les fichiers inutilisés pendant ce nombre de jours"

#: src/ui/settings.rs:1010
msgid "Keep all files (default)"
msgstr "Conserver tous les fichiers (par défaut)"

#: src/ui/settings.rs:1019
msgid "Encrypted account backups"
msgstr "Sauvegardes chiffrées du compte"

#: src/ui/settings.rs:1020
msgid ""
"Save the account and downloaded files with a passphrase. Restore into a "
"separate account, initially offline."
msgstr ""
"Enregistre le compte et les fichiers téléchargés avec une phrase secrète. "
"Restaure dans un compte séparé, initialement hors ligne."

#: src/ui/settings.rs:1023
msgid "Back up…"
msgstr "Sauvegarder…"

#: src/ui/settings.rs:1027
msgid "Restore…"
msgstr "Restaurer…"

#: src/ui/settings.rs:1032
msgid "Review merge…"
msgstr "Vérifier la fusion…"

#: src/ui/settings.rs:1039
msgid "Restored account connection"
msgstr "Connexion du compte restauré"

#: src/ui/settings.rs:1042
msgid ""
"This account stays offline until you resume its saved linked-device session."
msgstr ""
"Ce compte reste hors ligne jusqu’à la reprise de sa session enregistrée "
"d’appareil associé."

#: src/ui/settings.rs:1049
msgid "Resume connection…"
msgstr "Reprendre la connexion…"

#: src/ui/settings.rs:1062
msgid "Download folders"
msgstr "Dossiers de téléchargement"

#: src/ui/settings.rs:1065
msgid ""
"Organize future downloads in your chosen folder. Existing files stay where "
"they are."
msgstr ""
"Organise les prochains téléchargements dans le dossier choisi. Les fichiers "
"existants restent à leur emplacement."

#: src/ui/settings.rs:1091
msgid "Include older files in automatic downloads"
msgstr "Inclure les anciens fichiers dans les téléchargements automatiques"

#: src/ui/settings.rs:1092
msgid ""
"Copy files from before automatic downloads were enabled into your chosen "
"folder. Full history recovery still keeps older files in the private "
"archive."
msgstr ""
"Copier dans le dossier choisi les fichiers antérieurs à l’activation des "
"téléchargements automatiques. La récupération complète de l’historique "
"conserve toujours les anciens fichiers dans l’archive privée."

#: src/ui/settings.rs:1096
msgid "Preserve original download names"
msgstr "Conserver les noms d’origine des téléchargements"

#: src/ui/settings.rs:1097
msgid ""
"Use the original document filename inside your chosen folders. Unsafe "
"characters are removed and duplicate names get a number."
msgstr ""
"Utiliser le nom de fichier d’origine du document dans les dossiers choisis. "
"Les caractères non sûrs sont supprimés et les noms en double reçoivent un "
"numéro."

#: src/ui/settings.rs:1101
msgid "Readable download names"
msgstr "Noms de téléchargement lisibles"

#: src/ui/settings.rs:1102
msgid ""
"Include the chat, message date (UTC), file type and original document name. "
"The private media archive keeps its own files."
msgstr ""
"Inclut la discussion, la date du message (UTC), le type de fichier et le nom"
" original du document. L’archive privée des médias conserve ses propres "
"fichiers."

