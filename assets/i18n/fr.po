msgstr ""
"Modifie la photo de ce contact uniquement dans ce compte, sur cet ordinateur"

#: src/ui/dialogs.rs:2128
msgid "Reset local picture"
msgstr "Réinitialiser la photo locale"

#: src/ui/dialogs.rs:2324
msgid "Community announcements"
msgstr "Annonces de la communauté"

#: src/ui/dialogs.rs:2326
msgid "Community general chat"
msgstr "Discussion générale de la communauté"

#: src/ui/dialogs.rs:2328
msgid "Community group"
msgstr "Groupe de la communauté"

